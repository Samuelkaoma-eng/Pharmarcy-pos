        subgraph STOCK["Stock and procurement"]
            direction LR
            UC18(["UC-18 Manage Product Catalogue"]):::uc
            UC19(["UC-19 Look Up Medicine in Drug Directory"]):::uc
            UC20(["UC-20 Manage Suppliers"]):::uc
            UC21(["UC-21 Raise Purchase Order"]):::uc
