            UC10(["UC-10 Issue Receipt"]):::uc
            UC11(["UC-11 View Sales History"]):::uc
            UC30(["UC-30 Record Fiscal Reference"]):::uc
        end

        subgraph CLIN["Dispensing and clinical"]
            direction LR
            UC12(["UC-12 Register Patient"]):::uc
