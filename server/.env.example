# Copy this file to server/.env and fill in what you need.
# .env is git-ignored. Never commit a real key — the CI pipeline fails the
# build if one appears in the tree, and a key that reached git history has to
# be rotated, not just deleted.

PORT=5000

# development or production. In production the server serves the built client
# from client/dist, and the demonstration seed below is withheld.
NODE_ENV=development

# --- Database -------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=pharmacy_pos
DB_USER=postgres
DB_PASSWORD=your_db_password_here

# --- Tokens ---------------------------------------------------------------
# Signs the access token. middleware/auth.js falls back to a default so that a
# fresh checkout runs, and that default is committed to this repository — so
# anything reachable from outside your own machine MUST set this. Without it,
# anyone who has read the source can forge a token for any role, SuperAdmin
# included.
#
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# There is deliberately no REFRESH_SECRET. The refresh token is a random 32-byte
# value stored only as a SHA-256 hash rather than a signed JWT, so it has no
# signing key. The CI workflow still sets one; nothing reads it.

# How long a refresh chain stays valid. Defaults to 7.
REFRESH_TTL_DAYS=7

# --- CORS -----------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Language model (optional) --------------------------------------------
# Used by the workflow assistant, and to summarise clinical records the system
# already holds. Claude is tried first, Gemini second. With neither key set,
# record lookup still works and the summary reports itself unavailable — it
# never invents an answer.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Drug interaction screening (optional) --------------------------------
# The NLM retired its free interaction API on 2 January 2024. With no source
# configured the basket check reports that it COULD NOT be screened, and never
# that it is clear. Point this at a licensed source to enable real screening.
INTERACTION_API_URL=

# --- Uploads --------------------------------------------------------------
# Compliance documents are stored outside the source tree and are never served
# as static content. On a hosting platform this must point at a mounted volume
# or uploads are lost on every redeploy.
UPLOAD_DIR=

# --- Demonstration data ---------------------------------------------------
# seed_data.sql creates demo pharmacies and staff accounts whose password is
# published in the demo script. It is applied automatically on first run unless
# NODE_ENV is production, where it is withheld until this is true (DEF-053).
#
# Set it for a marked demo on a hosted database. Do not set it for anything
# real: it would create reachable logins with a known password.
SEED_DEMO_DATA=false

# --- Reference data (optional) --------------------------------------------
# openFDA needs no key. Defaults are correct; override only for a mirror.
FDA_BASE_URL=
RXNAV_BASE_URL=

# Salts the simulated fiscal signature. SIMFIS is a simulation, marked as one
# everywhere it appears — this is not a real ZRA credential, and there is no
# real one to hold (LIM-005).
SIMFIS_DEVICE_SECRET=
